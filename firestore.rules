rules_version = '2';

// 受管理內容發佈工作流的授權（#8 Published-only authorization / #9 Q&A safety）。
//
// 核心不變量：
//  - **只有 status == 'published' 的文件可被學生端公開讀取。**
//    Draft / Review / Rejected / Archived 一律讀不到（不是靠 UI 隱藏，是這裡真正擋）。
//  - **workspace（草稿/送審/退回/封存工作副本）只有管理員可讀寫**；學生端永遠讀不到。
//  - 一般使用者只能讀寫自己的 private user data。
//  - 只有管理員能 create/review/publish/archive 受管理內容。
//  - 一般使用者投稿（submissions / questions）不得自行設定 status / published / reviewer /
//    publisher（rules 於 create 限制欄位；他們無權更新這些集合，故無法自我發佈）。
//
// ⚠️ 部署順序：先跑 tools/backfill_status（把 legacy 文件補上 status='published'
//    + version + provenance），**再**部署本規則；否則未補 status 的 legacy 內容會
//    立即對學生端 fail-closed（讀不到）。本輪不部署（見交接說明）。
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // 管理員授權（backward-compatible）：優先看 custom claim `admin==true`
    // （未來多管理員／角色的正式路徑），同時保留 legacy 單一 email（不破壞現有登入）。
    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.admin == true
            || request.auth.token.email == 'zhen20091212@gmail.com');
    }
    // 公開可讀＝已發佈。
    function isPublished() {
      return resource.data.status == 'published';
    }
    // Study Content／Study Topic 的**學生可讀**條件：status==published **且**
    // visibility==student，兩者缺一不可。任一欄位缺失／非該值即為 false（**fail-closed**）。
    // Published≠Student-visible：Published+Internal 讀不到；visibility 不由 status 推導。
    function isStudentVisible() {
      return resource.data.status == 'published'
        && resource.data.visibility == 'student';
    }
    // ---- Church/Teacher R1：audience 授權（受管理內容對 Student 的唯一 authority）----
    // 目前使用者的 Active Church id（只有 memberships/{uid}.status=='active' 才算數）。
    function activeChurchId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.status == 'active'
        ? get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.church_id
        : null;
    }
    // Student 可讀 ⇔ published 且（public，或 church 且 activeChurchId ∈ allowedChurchIds）。
    // audience 缺失/'internal'、church 但 allowedChurchIds 空/無授權 → 全 false（fail-closed）。
    function audienceOK() {
      return resource.data.status == 'published' && (
        resource.data.audience == 'public'
        || (resource.data.audience == 'church'
            && resource.data.allowed_church_ids is list
            && activeChurchId() != null
            && (activeChurchId() in resource.data.allowed_church_ids))
      );
    }

    // ---- 個人私有資料：只有本人能存取（含所有子集合：bookmarks/highlights/
    //      notes/reading_log/chapter_completions/plan_item_progress/later/
    //      sermon_notes/plan_progress/prayers/todos/following/saved_questions/
    //      tombstones …）----
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- 受管理內容（published mirror）：Published 才可公開讀，僅管理員可寫 ----
    // annotations（卷/章導讀、節註解）、knowledge（知識架構）、daily_verses（每日經文）、
    // reading_plans（讀經計畫）、public_notes（審核通過的公開註解）。
    // annotations：Church/Teacher R1 起改用 audience 授權（public/church/internal）。
    // ⚠️ 需先 migrate annotations audience（見 tools/migrate_audience.mjs）再部署，
    // 否則未補 audience 的 legacy 註解會 fail-closed 隱藏（安全但暫不顯示）。
    match /annotations/{doc} {
      allow read: if audienceOK() || isAdmin();
      allow write: if isAdmin();
    }
    match /knowledge/{doc} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }
    match /reading_plans/{doc} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }
    match /public_notes/{doc} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }
    // 每日經文：**只以 status=='published' 為準**（production managed collections 經唯讀
    // audit 確認為空，無需維持 legacy published==true 的 serving 相容）。
    match /daily_verses/{doc} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    // ---- Study Content（新版研讀內容，per-item workflow + visibility）----
    // 學生端讀取需 **published 且 visibility==student**（見 isStudentVisible）；
    // Published+Internal 學生讀不到。歷史版本子集合與 workspace 皆 admin-only，
    // 學生不得經此繞過 current visibility。
    match /study_content/{doc} {
      allow read: if audienceOK() || isAdmin();
      allow write: if isAdmin();
    }
    match /study_content/{doc}/versions/{vid} {
      allow read, write: if isAdmin();
    }
    match /study_content_workspace/{doc} {
      allow read, write: if isAdmin();
    }
    // Study Topic（Option A：Topic 自帶 audience，與 Study Content 同 authorization）。
    match /study_topics/{doc} {
      allow read: if audienceOK() || isAdmin();
      allow write: if isAdmin();
    }
    match /study_topics/{doc}/versions/{vid} {
      allow read, write: if isAdmin();
    }
    match /study_topics_workspace/{doc} {
      allow read, write: if isAdmin();
    }

    // ---- Church / Membership（Church/Teacher R1）----
    // churches：只讀 active 的公開表示；私有資料在 churches/{id}/private/**（admin-only）。
    match /churches/{churchId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /churches/{churchId}/private/{doc} {
      allow read, write: if isAdmin();
    }
    // memberships/{uid}（doc id=uid）：本人可讀自己；本人只能建立自己的 pending
    // （且不得自設 reviewed/active/rejected/revoked、target church 須 active）；
    // approve/reject/revoke 只有 admin。
    match /memberships/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewed_by == ''
        && exists(/databases/$(database)/documents/churches/$(request.resource.data.church_id))
        && get(/databases/$(database)/documents/churches/$(request.resource.data.church_id)).data.active == true;
      // 重新申請：rejected/revoked 的本人可把自己改回 pending（不得自設 active），
      // target church 須 active。approve/reject/revoke 及其他一律 admin。
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && resource.data.status in ['rejected', 'revoked']
            && request.resource.data.status == 'pending'
            && request.resource.data.reviewed_by == ''
            && exists(/databases/$(database)/documents/churches/$(request.resource.data.church_id))
            && get(/databases/$(database)/documents/churches/$(request.resource.data.church_id)).data.active == true);
      allow delete: if isAdmin();
    }
    match /memberships/{uid}/history/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- 老師專區結構（audience-gated；teaching body = study_content）----
    match /teacher_books/{bookId} {
      allow read: if audienceOK() || isAdmin();
      allow write: if isAdmin();
      match /chapters/{chapterId} {
        allow read: if audienceOK() || isAdmin();
        allow write: if isAdmin();
      }
    }
    match /teacher_books_workspace/{doc} {
      allow read, write: if isAdmin();
    }

    // ---- 受管理內容（workspace）：草稿/送審/退回/封存工作副本，**僅管理員** ----
    // 命名一律 `<type>_workspace`；學生端讀不到，因此 Draft/Review 不會外流。
    match /annotations_workspace/{doc} {
      allow read, write: if isAdmin();
    }
    match /knowledge_workspace/{doc} {
      allow read, write: if isAdmin();
    }
    match /reading_plans_workspace/{doc} {
      allow read, write: if isAdmin();
    }
    match /public_notes_workspace/{doc} {
      allow read, write: if isAdmin();
    }
    match /daily_verses_workspace/{doc} {
      allow read, write: if isAdmin();
    }

    // ---- 公開註解投稿（使用者投稿 → 管理員審核）----
    // 投稿者只能建立 status=='pending' 的自己的投稿；不得自設核准/發佈欄位。
    match /submissions/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---- 疑問 Q&A（#9 + Church/Teacher R1 B19）----
    // 學生可讀 ⇔ published==true **且 audience 授權通過**（Church-sourced answer 機密性）：
    //   public → 全體；church → Active Membership churchId ∈ allowed_church_ids。
    //   audience 缺失/'internal'/未知 → **fail-closed**（只有本人/管理員可讀）。
    //   → 鎖 source link 不足以保護 church 內容；answer 本身也必須 audience-authorized。
    // 本人可讀自己的（含未發佈，看狀態）、管理員可讀全部。
    // 提問者只能建立 status=='pending' 且 published==false 的自己的問題（不得自我發佈/回答）。
    // 審核／回答／發布／精選只有管理員能寫。提問者可刪自己的問題。
    function qaAudienceOK() {
      return resource.data.published == true && (
        resource.data.audience == 'public'
        || (resource.data.audience == 'church'
            && resource.data.allowed_church_ids is list
            && activeChurchId() != null
            && (activeChurchId() in resource.data.allowed_church_ids))
      );
    }
    match /questions/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.published == false;
      allow read: if qaAudienceOK()
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || isAdmin();
      allow update: if isAdmin();
      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 其餘一切預設拒絕（Firestore 預設行為；未匹配路徑不可讀寫）。
  }
}
